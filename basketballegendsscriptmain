--// ================================
local autoGuardEnabled    = false
local autoGuardConnection = nil
local lastPositions       = {}
local predictionTime      = 0.3
local guardDistance       = 10
local autoGuardPaused     = false


local stealBtn = gui.Main.Mobile.Holder.Steal
stealBtn.Activated:Connect(function()
    autoGuardPaused = true
    GuardRemote:FireServer(false)
    task.wait(1.5)
