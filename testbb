local bar = gui.Visual.Shooting.Bar
local btn = gui.Main.Mobile.Holder.Shoot
local smartContestEnabled = false
local contestMeter = gui.Visual.ShotInfo.Contest.Meter


local shotEnabled  = true
local ShotAccuracy = 1.0

local autoMixEnabled    = false


local function getSmartAccuracy()
    local text = contestMeter.Text
    local percent = text:match("(%d+)%%")
    if percent then
        percent = tonumber(percent)
        if percent <= 15 then
            return 0.95
        else
            return 1.0
        end
    end
    if text == "WIDE OPEN" then
        return 0.95
    else
        return 1.0
    end
end


local function getAutoMixAccuracy()
    return math.random(1, 10) <= 3 and 1.0 or 0.95
end


local function shoot()
    if not shotEnabled then return end
    local char = player.Character
    if char and char:FindFirstChild("Basketball") then
        local accuracy
        if smartContestEnabled then
            task.wait(0.05)
            accuracy = getSmartAccuracy()
        else
            accuracy = autoMixEnabled and getAutoMixAccuracy() or ShotAccuracy
        end
        bar:TweenSize(UDim2.fromScale(1, accuracy), Enum.EasingDirection.Out, Enum.EasingStyle.Linear, Config.TweenTime, true)
        bar.Size = UDim2.fromScale(1, accuracy)
    end
end



for _, e in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
